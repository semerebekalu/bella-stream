# Client (set in Netlify → Site settings → Environment variables)
# Must point at your always-on Socket.IO host (Render / Railway / Fly).
# Netlify alone cannot host the WebSocket signaling server.
VITE_SOCKET_URL=https://your-bella-stream.onrender.com

# Server (set on Render / Railway / Fly)
PORT=3001
# Comma-separated browser origins allowed to talk to Socket.IO
CORS_ORIGIN=https://your-site.netlify.app,http://localhost:5173
